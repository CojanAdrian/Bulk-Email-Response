VITE_API_URL=http://localhost:4000
# Browser-restricted Google Maps API key (Maps JavaScript API + Directions API
# enabled, HTTP referrer restrictions set to your domain(s)) -- powers the
# live satellite map + real driving routes on the Carriers tab. Separate
# from the backend's GOOGLE_MAPS_API_KEY (server-side geocoding key).
VITE_GOOGLE_MAPS_API_KEY=
