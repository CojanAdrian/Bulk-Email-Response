{
  "name": "bulkposting-desktop",
  "productName": "BulkPosting",
  "version": "1.1.0",
  "description": "BulkPosting as a desktop app.",
  "main": "main.js",
  "private": true,
  "author": "BulkPosting",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.bulkposting.desktop",
    "productName": "BulkPosting",
    "files": [
      "main.js",
      "preload.js",
      "address.js",
      "pages/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BulkPosting",
      "artifactName": "BulkPosting-Setup.exe"
    }
  },
  "allowScripts": {
    "electron@44.11.3": true
  }
}
